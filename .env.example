# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Gateway ────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be 32+ chars. In prod, load from a secret manager (AWS Secrets Manager / Vault / etc).
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Comma-separated origins. REQUIRED in production (gateway refuses to boot if missing).
ALLOWED_ORIGINS=http://localhost:3100

# ─── Microservices Ports ─────────────────────────────────────────────────────
USER_SERVICE_PORT=3001
EVENT_SERVICE_PORT=3002
REGISTRATION_SERVICE_PORT=3003
EMAIL_SERVICE_PORT=3004
CHECKIN_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
ANALYTICS_SERVICE_PORT=3007
FILE_SERVICE_PORT=3008
TASK_SERVICE_PORT=3009
SUPPORT_SERVICE_PORT=3010
NETWORKING_SERVICE_PORT=3011

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=it_event_platform
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# `DB_SYNC=true` enables TypeORM auto-schema (DEV ONLY). Hard-disabled when NODE_ENV=production.
# Once migrations exist, leave unset and run `npm run migration:run` instead.
DB_SYNC=true

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=it-event-platform-files
AWS_CLOUDFRONT_URL=https://your-distribution.cloudfront.net
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# ─── AWS Cognito ─────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email Providers ─────────────────────────────────────────────────────────
# With NONE of these set, email-service uses a `dev` transport that writes
# rendered emails to apps/email-service/.maildev/*.html (override with
# MAIL_PREVIEW_DIR) instead of sending — so confirmation emails are demoable
# offline. Set a provider below to actually send.
BREVO_API_KEY=your-brevo-api-key
SENDGRID_API_KEY=your-sendgrid-api-key
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
# MAIL_PREVIEW_DIR=.maildev

# ─── Payment ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ─── Slack ──────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SUPPORT_CHANNEL=#support-tickets

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
